# Copy to .env (gitignored) and fill in. Never commit real values: this repository is public.

# The API the app talks to.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000

# RevenueCat public SDK key from the RevenueCat dashboard (the Test Store key while testing).
EXPO_PUBLIC_REVENUECAT_API_KEY=your_revenuecat_public_sdk_key
# Optional per-platform keys; each overrides the shared key on its platform.
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
