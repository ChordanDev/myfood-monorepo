{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Knip's Expo plugin expects these from the app config, but the app does not
  // use over-the-air updates or a runtime system UI colour. Installing them
  // would change the native build, so they stay out until a feature needs them.
  "ignoreDependencies": ["expo-updates", "expo-system-ui"]
}
