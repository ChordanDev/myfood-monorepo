# Copiar este archivo a .envrc.local y completar valores reales.

export GEMINI_API_KEY="pega_tu_api_key_aqui"
# export GEMINI_BASE_URL="https://generativelanguage.googleapis.com"

# Server
# export PORT="4000"
# export PHX_HOST="localhost"
# export SECRET_KEY_BASE="replace_with_generated_secret"

# AI
# export AI_CLIENT="gemini"
# export GEMINI_MODEL="gemini-2.5-flash-lite"
# export GEMINI_TIMEOUT_MS="15000"

# Social sign-in (issue #106): the Google web client ID the app's SDK asks
# ID tokens for, and for Apple the app's bundle ID (`ios.bundleIdentifier`
# in apps/mobile/app.json).
# export GOOGLE_OAUTH_CLIENT_IDS="your_google_web_client_id"
# export APPLE_OAUTH_CLIENT_IDS="your_ios_bundle_id"

# Provider endpoint overrides (optional)
# export GOOGLE_TOKENINFO_URL="https://oauth2.googleapis.com/tokeninfo"
# export APPLE_JWKS_URL="https://appleid.apple.com/auth/keys"
